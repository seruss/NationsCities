@* 
    VotingView.razor - SPA Voting View
    Converted from Validation.razor to work with ClientGameStateService
*@
@using NationsCities.Models
@using NationsCities.Services
@inject ClientGameStateService GameState
@implements IDisposable

<PageTitle>Głosowanie - Państwa, Miasta</PageTitle>



@if (GameState.CurrentRoom == null || GameState.CurrentGame == null || _answersForVoting == null)
{
    <div class="flex items-center justify-center min-h-screen bg-bg-light dark:bg-bg-dark">
        <div class="flex flex-col items-center gap-4">
            <span class="material-symbols-outlined text-4xl text-primary animate-spin">progress_activity</span>
            <p class="text-slate-500 dark:text-slate-400">Ładowanie odpowiedzi...</p>
        </div>
    </div>
}
else if (!_categoriesWithAnswers.Any())
{
    <div class="flex flex-col min-h-screen bg-bg-light dark:bg-bg-dark items-center justify-center">
        <span class="material-symbols-outlined text-6xl text-green-500 mb-4">check_circle</span>
        <h1 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Brak odpowiedzi do głosowania</h1>
        <p class="text-slate-500 dark:text-slate-400">Czekam na innych graczy...</p>
        <p class="text-sm text-slate-400 mt-2 flex items-center gap-2">
            <span class="material-symbols-outlined animate-spin text-base">progress_activity</span>
            @_votesSubmittedCount/@_totalPlayers
        </p>
    </div>
}
else
{
    var currentCategory = _categoriesWithAnswers.ElementAtOrDefault(_currentCategoryIndex);
    var categoryName = currentCategory?.Name ?? "";
    var answersForCurrentCategory = _filteredAnswers.Where(a => a.Category == categoryName).ToList();
    var myAnswer = GetMyAnswerForCategory(categoryName);
    var isLastCategory = _currentCategoryIndex == _categoriesWithAnswers.Count - 1;
    var allVotedInCategory = answersForCurrentCategory.All(a => _myVotes.ContainsKey(a.Id));
    
    <div class="flex flex-col min-h-screen bg-bg-light dark:bg-bg-dark">
        <!-- Header with category name and progress -->
        <header class="sticky top-0 z-20 bg-surface-light dark:bg-surface-dark border-b border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center px-4 h-16 justify-between max-w-lg mx-auto w-full">
                <!-- Back arrow -->
                <button @onclick="GoToPrevCategory"
                        disabled="@(_currentCategoryIndex == 0)"
                        class="@(_currentCategoryIndex == 0 ? "opacity-0 pointer-events-none" : "") w-9 h-9 flex items-center justify-center rounded-full border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <span class="material-symbols-outlined text-xl">arrow_back</span>
                </button>
                <div class="text-center">
                    <h1 class="text-lg font-bold text-slate-900 dark:text-white">@categoryName</h1>
                    <span class="text-xs text-primary font-semibold">@(_currentCategoryIndex + 1) / @_categoriesWithAnswers.Count</span>
                </div>
                <!-- Forward arrow (ghost when on last) -->
                <button @onclick="GoToNextCategory"
                        disabled="@(isLastCategory)"
                        class="@(isLastCategory ? "opacity-0 pointer-events-none" : "") w-9 h-9 flex items-center justify-center rounded-full border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <span class="material-symbols-outlined text-xl">arrow_forward</span>
                </button>
            </div>
            
            <!-- Progress bar -->
            <div class="h-1 w-full bg-slate-200 dark:bg-slate-700">
                <div class="h-full bg-primary transition-all duration-300" style="width: @((_currentCategoryIndex + 1) * 100 / _categoriesWithAnswers.Count)%"></div>
            </div>
        </header>

        <!-- Main content -->
        <main class="flex-1 flex flex-col overflow-y-auto w-full max-w-lg mx-auto px-4 pt-4 pb-4" data-scrollable="true">
            <!-- "Twoja odpowiedź" header -->
            @if (!string.IsNullOrWhiteSpace(myAnswer))
            {
                <div class="w-full bg-primary/10 dark:bg-surface-dark border border-primary/20 dark:border-slate-700 rounded-xl p-4 mb-4 flex items-center justify-between">
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Twoja odpowiedź:</span>
                    <span class="text-lg font-bold text-primary dark:text-white">@myAnswer</span>
                </div>
            }
            else
            {
                <div class="w-full bg-slate-100 dark:bg-surface-dark border border-slate-200 dark:border-slate-700 rounded-xl p-4 mb-4 flex items-center justify-between">
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Twoja odpowiedź:</span>
                    <span class="text-lg font-medium text-slate-400 dark:text-slate-500 italic">Brak</span>
                </div>
            }

            <!-- Legend -->
            <div class="flex items-center gap-3 mb-3 px-1">
                <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase tracking-wider">Oceń odpowiedzi innych:</span>
            </div>
            <div class="flex gap-2 mb-4 flex-wrap">
                <span class="flex items-center gap-1 text-[11px] font-semibold text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-full px-2.5 py-1">
                    <span class="material-symbols-outlined text-sm" style="font-size:14px">check</span>Poprawna
                </span>
                <span class="flex items-center gap-1 text-[11px] font-semibold text-red-500 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-full px-2.5 py-1">
                    <span class="material-symbols-outlined text-sm" style="font-size:14px">close</span>Błędna
                </span>
                <span class="flex items-center gap-1 text-[11px] font-semibold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-full px-2.5 py-1">
                    <span class="material-symbols-outlined text-sm" style="font-size:14px">content_copy</span>Duplikat
                </span>
            </div>
            
            <!-- Answer list -->
            <div class="flex-1 space-y-3">
                @foreach (var answer in answersForCurrentCategory)
                {
                    var isAutoDetected = answer.IsAutoDetectedDuplicate;
                    var votedValid = HasVotedValid(answer);
                    var votedInvalid = HasVotedInvalid(answer);
                    var votedDuplicate = HasVotedDuplicate(answer);
                    var hasVoted = _myVotes.ContainsKey(answer.Id);
                    
                    <div class="@($"bg-surface-light dark:bg-surface-dark rounded-xl shadow-sm border {(isAutoDetected ? "border-amber-300 dark:border-amber-600" : "border-slate-200 dark:border-slate-700")} flex flex-col gap-3 p-4")">
                        <!-- Answer text and variants -->
                        <div class="flex items-start justify-between gap-3">
                            @if (isAutoDetected && answer.DuplicateGroupAnswers.Count > 1)
                            {
                                <!-- Show all variants for auto-detected duplicates -->
                                <div class="flex flex-col">
                                    <span class="text-lg font-bold text-slate-800 dark:text-white">@string.Join(" / ", answer.DuplicateGroupAnswers.Take(3))</span>
                                    @if (answer.DuplicateGroupAnswers.Count > 3)
                                    {
                                        <span class="text-xs text-slate-400">+@(answer.DuplicateGroupAnswers.Count - 3) więcej...</span>
                                    }
                                    <span class="text-xs text-amber-500 flex items-center gap-1 mt-1">
                                        <span class="material-symbols-outlined text-sm">auto_awesome</span>
                                        Automatycznie zgrupowano (@answer.SubmittedBy.Count graczy)
                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="text-lg font-bold text-slate-800 dark:text-white">@answer.Answer</span>
                            }
                            
                            @if (hasVoted)
                            {
                                <span class="shrink-0 text-[11px] font-bold rounded-full px-2 py-0.5 @(votedValid ? "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400" : votedInvalid ? "bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400" : "bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400")">
                                    @(votedValid ? "✓ Poprawna" : votedInvalid ? "✗ Błędna" : "⧉ Duplikat")
                                </span>
                            }
                        </div>
                        
                        <!-- Voting buttons row -->
                        <div class="flex gap-2 @(_hasSubmittedVotes ? "opacity-50 pointer-events-none" : "")">
                            <button @onclick="@(() => Vote(answer.Id, "valid"))"
                                    disabled="@_hasSubmittedVotes"
                                    class="@($"flex-1 h-10 rounded-lg flex items-center justify-center gap-1.5 text-sm font-semibold transition-all {(votedValid ? "bg-green-500 text-white shadow-md shadow-green-500/20" : "border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-green-50 dark:hover:bg-slate-700 hover:text-green-600 dark:hover:text-green-400 hover:border-green-300 dark:hover:border-green-700")}")">
                                <span class="material-symbols-outlined text-base" style="font-size:18px">check</span>
                                <span>Poprawna</span>
                            </button>
                            <button @onclick="@(() => Vote(answer.Id, "invalid"))"
                                    disabled="@_hasSubmittedVotes"
                                    class="@($"flex-1 h-10 rounded-lg flex items-center justify-center gap-1.5 text-sm font-semibold transition-all {(votedInvalid ? "bg-red-500 text-white shadow-md shadow-red-500/20" : "border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-red-50 dark:hover:bg-slate-700 hover:text-red-600 dark:hover:text-red-400 hover:border-red-300 dark:hover:border-red-700")}")">
                                <span class="material-symbols-outlined text-base" style="font-size:18px">close</span>
                                <span>Błędna</span>
                            </button>
                            @if (!isAutoDetected)
                            {
                                <button @onclick="@(() => Vote(answer.Id, "duplicate"))"
                                        disabled="@_hasSubmittedVotes"
                                        class="@($"flex-1 h-10 rounded-lg flex items-center justify-center gap-1.5 text-sm font-semibold transition-all {(votedDuplicate ? "bg-amber-500 text-white shadow-md shadow-amber-500/20" : "border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-amber-50 dark:hover:bg-slate-700 hover:text-amber-600 dark:hover:text-amber-400 hover:border-amber-300 dark:hover:border-amber-700")}")">
                                    <span class="material-symbols-outlined text-base" style="font-size:18px">content_copy</span>
                                    <span>Duplikat</span>
                                </button>
                            }
                        </div>
                    </div>
                }
                
                @if (!answersForCurrentCategory.Any())
                {
                    <div class="text-center py-8">
                        <span class="material-symbols-outlined text-4xl text-slate-400 dark:text-slate-600">inbox</span>
                        <p class="text-slate-500 dark:text-slate-400 mt-2">Brak odpowiedzi do głosowania w tej kategorii</p>
                    </div>
                }
            </div>
        </main>

        <!-- Footer -->
        <footer class="sticky bottom-0 p-4 bg-surface-light dark:bg-surface-dark border-t border-slate-200 dark:border-slate-800 z-20 w-full safe-area-bottom">
            <div class="max-w-lg mx-auto w-full flex flex-col gap-2">
                @if (_hasSubmittedVotes)
                {
                    <div class="text-center py-4">
                        <p class="text-lg font-bold text-green-400 flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">check_circle</span>
                            Głosy przesłane!
                        </p>
                        <p class="text-sm text-slate-400 mt-1">Czekam na innych graczy... (@_votesSubmittedCount/@_totalPlayers)</p>
                    </div>
                    
                    @if (GameState.IsHost)
                    {
                        <button @onclick="ForceEndVoting"
                                class="w-full text-center text-sm font-medium text-slate-400 hover:text-red-400 py-2 transition-colors">
                            Wymuś zakończenie głosowania
                        </button>
                    }
                }
                else if (isLastCategory)
                {
                    <!-- Last category — show submit/confirm button -->
                    var pendingCount = _categoriesWithAnswers.SelectMany(c =>
                        _filteredAnswers.Where(a => a.Category == c.Name && !_myVotes.ContainsKey(a.Id))).Count();
                    
                    <button @onclick="ShowSubmitConfirmation"
                            class="@($"w-full h-13 flex items-center justify-center gap-2 rounded-xl font-bold text-base py-4 transition-all shadow-lg btn-press {(pendingCount == 0 ? "bg-primary hover:bg-primary-dark text-white shadow-primary/20" : "bg-slate-200 dark:bg-slate-700 text-slate-500 dark:text-slate-400")}")">
                        <span class="material-symbols-outlined">@(pendingCount == 0 ? "send" : "warning")</span>
                        @if (pendingCount > 0)
                        {
                            <span>Wyślij głosy (pominięto @pendingCount)</span>
                        }
                        else
                        {
                            <span>Wyślij głosy</span>
                        }
                    </button>
                }
                else
                {
                    <!-- Not last category — show Next button -->
                    <button @onclick="GoToNextCategory"
                            class="w-full h-13 flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white font-bold text-base py-4 rounded-xl shadow-lg shadow-primary/20 transition-all btn-press">
                        <span>Następna kategoria</span>
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                }
            </div>
        </footer>
    </div>
    
    <!-- Confirmation modal before submitting votes -->
    @if (_showSubmitConfirmation)
    {
        var totalAnswers = _filteredAnswers.Count;
        var votedAnswers = _myVotes.Count;
        var unvoted = totalAnswers - votedAnswers;
        
        <div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-4 modal-overlay-anim" @onclick="HideSubmitConfirmation">
            <div class="bg-surface-light dark:bg-surface-dark rounded-2xl w-full max-w-sm shadow-2xl border border-slate-200 dark:border-slate-700 overflow-hidden" @onclick:stopPropagation="true">
                <div class="p-6 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-3 mb-1">
                        <span class="material-symbols-outlined text-primary text-2xl">how_to_vote</span>
                        <h2 class="text-base font-bold text-slate-900 dark:text-white">Wysłać głosy?</h2>
                    </div>
                    @if (unvoted > 0)
                    {
                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
                            Oceniono <strong class="text-slate-700 dark:text-white">@votedAnswers / @totalAnswers</strong> odpowiedzi.
                            <span class="text-amber-500 font-medium">@unvoted bez oceny</span> — zostaną pominięte.
                        </p>
                    }
                    else
                    {
                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
                            Oceniono wszystkie <strong class="text-slate-700 dark:text-white">@totalAnswers</strong> odpowiedzi. Gotowe!
                        </p>
                    }
                </div>
                <div class="flex gap-3 p-4">
                    <button @onclick="HideSubmitConfirmation"
                            class="flex-1 py-3 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-semibold text-sm hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                        Wróć
                    </button>
                    <button @onclick="ConfirmSubmitVotes"
                            class="flex-1 py-3 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-sm transition-colors shadow-lg shadow-primary/20">
                        Wyślij głosy
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<AnswerForVoting>? _answersForVoting;
    private List<AnswerForVoting> _filteredAnswers = [];
    private List<Category> _categoriesWithAnswers = [];
    private bool _hasSubmittedVotes = false;
    private int _votesSubmittedCount = 0;
    private int _totalPlayers = 0;
    private int _currentCategoryIndex = 0;
    private Dictionary<string, string?> _myVotes = new();
    private bool _hasInitialized = false;
    private bool _showSubmitConfirmation = false;

    protected override void OnInitialized()
    {
        GameState.OnStateChanged += HandleStateChanged;
        GameState.OnVotingEnded += HandleVotingEnded;
        GameState.OnVotesSubmittedChanged += HandleVotesSubmittedChanged;
        
        InitializeVoting();
    }

    private void InitializeVoting()
    {
        if (_hasInitialized || GameState.CurrentGame == null) return;
        _hasInitialized = true;
        
        _totalPlayers = GameState.CurrentRoom?.Players.Count ?? 0;
        _answersForVoting = GameState.CurrentGame.AnswersForVoting;
        
        // Filter out empty answers and own answers
        _filteredAnswers = _answersForVoting?
            .Where(a => !string.IsNullOrWhiteSpace(a.Answer))
            .Where(a => !a.SubmitterNicknames.Any(n => n.Equals(GameState.Nickname, StringComparison.OrdinalIgnoreCase)))
            .ToList() ?? [];
        
        // Filter categories to only those with answers to vote
        var categoriesWithAnswersNames = _filteredAnswers.Select(a => a.Category).Distinct().ToHashSet();
        _categoriesWithAnswers = GameState.CurrentGame.Categories
            .Where(c => categoriesWithAnswersNames.Contains(c.Name))
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasSubmittedVotes)
        {
            if (!_categoriesWithAnswers.Any())
            {
                // No answers to vote on — auto-submit immediately so voting doesn't stall
                await SubmitVotes();
            }
        }
    }

    private void HandleStateChanged()
    {
        if (!_hasInitialized && GameState.CurrentGame != null)
        {
            InitializeVoting();
        }
        InvokeAsync(StateHasChanged);
    }

    private void HandleVotingEnded()
    {
        // Phase transition handled by GameState
    }

    private void HandleVotesSubmittedChanged(int count)
    {
        _votesSubmittedCount = count;
        InvokeAsync(StateHasChanged);
    }

    private async Task Vote(string answerId, string voteType)
    {
        if (_hasSubmittedVotes) return;
        
        // Toggle off if same vote clicked again
        if (_myVotes.TryGetValue(answerId, out var existing) && existing == voteType)
        {
            _myVotes.Remove(answerId);
        }
        else
        {
            _myVotes[answerId] = voteType;
            await GameState.VoteAnswerAsync(answerId, voteType);
        }
        
        StateHasChanged();
    }

    private void GoToNextCategory()
    {
        if (_currentCategoryIndex < _categoriesWithAnswers.Count - 1)
        {
            _currentCategoryIndex++;
            StateHasChanged();
        }
    }

    private void GoToPrevCategory()
    {
        if (_currentCategoryIndex > 0)
        {
            _currentCategoryIndex--;
            StateHasChanged();
        }
    }

    private void ShowSubmitConfirmation()
    {
        _showSubmitConfirmation = true;
        StateHasChanged();
    }

    private void HideSubmitConfirmation()
    {
        _showSubmitConfirmation = false;
        StateHasChanged();
    }

    private async Task ConfirmSubmitVotes()
    {
        _showSubmitConfirmation = false;
        await SubmitVotes();
    }

    private async Task SubmitVotes()
    {
        if (_hasSubmittedVotes) return;
        
        _hasSubmittedVotes = true;
        await GameState.SubmitVotesAsync();
        StateHasChanged();
    }

    private async Task ForceEndVoting()
    {
        if (GameState.IsHost)
        {
            await GameState.FinalizeVotingAsync();
        }
    }

    private bool HasVotedValid(AnswerForVoting answer)
    {
        if (_myVotes.TryGetValue(answer.Id, out var vote))
            return vote == "valid";
        return false;
    }

    private bool HasVotedInvalid(AnswerForVoting answer)
    {
        if (_myVotes.TryGetValue(answer.Id, out var vote))
            return vote == "invalid";
        return false;
    }

    private bool HasVotedDuplicate(AnswerForVoting answer)
    {
        if (_myVotes.TryGetValue(answer.Id, out var vote))
            return vote == "duplicate";
        return false;
    }

    private string GetMyAnswerForCategory(string categoryName)
    {
        var myAnswer = _answersForVoting?
            .FirstOrDefault(a => a.Category == categoryName && 
                a.SubmitterNicknames.Any(n => n.Equals(GameState.Nickname, StringComparison.OrdinalIgnoreCase)));
        return myAnswer?.Answer ?? "";
    }

    public void Dispose()
    {
        GameState.OnStateChanged -= HandleStateChanged;
        GameState.OnVotingEnded -= HandleVotingEnded;
        GameState.OnVotesSubmittedChanged -= HandleVotesSubmittedChanged;
    }
}
